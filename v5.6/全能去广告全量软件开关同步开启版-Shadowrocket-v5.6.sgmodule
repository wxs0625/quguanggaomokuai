#!arguments-desc=true=启用该软件去广告；false=关闭。本版本按用户提供的 v5.3 文件同步开启项，仅开启：百度网盘、闪动校园、微信公众号、微博。软件太多时请先看“软件搜索索引.html/软件快速搜索.md/软件开关清单.md”定位开关名。

[Rule]
# v5.5 联网保护：仅作用闪动校园和酷安；其他软件规则不改
DOMAIN,report.shunchangzhixing.com,REJECT
URL-REGEX,^https?:\/\/(?:ad|report)\.shunchangzhixing\.com\/(?:report|channel\/report|display|click|track|event|win|upload|material|splash|ad),REJECT
DOMAIN,api.huachenjie.com,DIRECT
DOMAIN-SUFFIX,huachenjie.com,DIRECT
DOMAIN-SUFFIX,shunchangzhixing.com,DIRECT
DOMAIN,api.coolapk.com,DIRECT
DOMAIN,www.coolapk.com,DIRECT
DOMAIN,coolapk.com,DIRECT

