#!name=全能去广告按需开关版 - Shadowrocket v5.0
#!desc=v5.0 轻量化按需版：从 v4.23 的 700+ 软件全量规则改为中文参数开关，只默认覆盖闪动校园、百度网盘、微博、微信公众号，并保留酷安安全入口。
#!author=fmz200，wxs0625，本地修复
#!homepage=https://github.com/wxs0625/quguanggaomokuai
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/gif/naisi-01.gif
#!date=2026-08-13
#!arguments=闪动校园规则:REJECT,闪动校园脚本:true,百度网盘规则:REJECT,百度网盘脚本:true,微博规则:REJECT,微信公众号规则:REJECT,微信公众号脚本:true,酷安规则:DIRECT,通用开屏SDK规则:DIRECT
#!arguments-desc=规则参数：REJECT=开启该软件去广告，DIRECT=关闭该软件规则；脚本参数：true=开启响应净化，false=关闭响应净化。酷安默认 DIRECT 是为了避免复现无网络；通用开屏SDK默认 DIRECT，需要更强开屏拦截时再改 REJECT。

# v5.0 说明
# - 单模块，不拆分；在 Shadowrocket 模块详情页的“编辑参数”里按中文软件名调整。
# - 主动删减 v4.23 中 700+ 软件的全量规则，避免未安装 App 也参与大量匹配。
# - 微博/酷安不重新启用历史深度 MITM 改写，避免回到“无网络/卡启动页”的问题。
# - 对于规则参数，REJECT 等于打开，DIRECT 等于关闭；这是为了让 [Rule] 能被参数控制。

[Rule]
# 闪动校园：保留 v4.19 有效的开屏广告域，并加主业务域直连兜底
DOMAIN,report.shunchangzhixing.com,{{{闪动校园规则}}}
DOMAIN,ad.shunchangzhixing.com,{{{闪动校园规则}}}
URL-REGEX,^https?:\/\/(?:ad|report)\.shunchangzhixing\.com\/(?:report|channel\/report|display|click|track|event|win|upload|material|splash|ad|getAd|base\/\d+),{{{闪动校园规则}}}
DOMAIN-SUFFIX,lovefree.cc,{{{闪动校园规则}}}
DOMAIN,adservice.sigmob.cn,{{{闪动校园规则}}}
DOMAIN-SUFFIX,sigmob.cn,{{{闪动校园规则}}}
DOMAIN-SUFFIX,gdt.qq.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,e.qq.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,pglstatp-toutiao.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,bytescm.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,1rtb.net,{{{闪动校园规则}}}
DOMAIN-SUFFIX,ubixioe.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,adfunlink.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,beizi.biz,{{{闪动校园规则}}}
DOMAIN-SUFFIX,adwangmai.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,66mobi.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,zhangyuyidong.cn,{{{闪动校园规则}}}
DOMAIN-SUFFIX,shenshiads.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,shanghailingye.cn,{{{闪动校园规则}}}
DOMAIN-SUFFIX,xcultur.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,tuia.cn,{{{闪动校园规则}}}
DOMAIN-SUFFIX,tobidad.cn,{{{闪动校园规则}}}
DOMAIN-SUFFIX,fancyapi.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,fancydsp.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,aiclk.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,qttunion.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,hubcloud.com.cn,{{{闪动校园规则}}}
DOMAIN-SUFFIX,1sapp.com,{{{闪动校园规则}}}
DOMAIN,gdfp.gifshow.com,{{{闪动校园规则}}}
DOMAIN,open.e.kuaishou.com,{{{闪动校园规则}}}
DOMAIN,open.e.kuaishou.cn,{{{闪动校园规则}}}
DOMAIN,baichuan-sdk.alicdn.com,{{{闪动校园规则}}}
DOMAIN,tnc3-alisc1.zijieapi.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,ctobsnssdk.com,{{{闪动校园规则}}}
DOMAIN-SUFFIX,shunchangzhixing.com,DIRECT

# 百度网盘：开屏广告、活动入口、PCS 广告接口
DOMAIN,afd.baidu.com,{{{百度网盘规则}}}
DOMAIN,afdconf.baidu.com,{{{百度网盘规则}}}
DOMAIN,als.baidu.com,{{{百度网盘规则}}}
DOMAIN,duclick.baidu.com,{{{百度网盘规则}}}
DOMAIN,hm.baidu.com,{{{百度网盘规则}}}
DOMAIN,hmma.baidu.com,{{{百度网盘规则}}}
DOMAIN,httpdns.baidubce.com,{{{百度网盘规则}}}
DOMAIN,mobads.baidu.com,{{{百度网盘规则}}}
DOMAIN,mobads-logs.baidu.com,{{{百度网盘规则}}}
DOMAIN,nadvideo2.baidu.com,{{{百度网盘规则}}}
DOMAIN,nsclick.baidu.com,{{{百度网盘规则}}}
DOMAIN-SUFFIX,mobads.baidu.com,{{{百度网盘规则}}}
URL-REGEX,^https?:\/\/issuecdn\.baidupcs\.com\/issue\/netdisk\/(?:guanggao|ts_ad),{{{百度网盘规则}}}
URL-REGEX,^https?:\/\/pan\.baidu\.com\/(?:act\/.+\/bchannel\/list|act\/api\/activityentry|act\/v\d\/(?:bchannel|welfare)\/list|api\/certuser\/get|api\/useractivity\/activity|component\/view\/(?:1510|1130)\?vip|pmall\/order\/privilege\/info|rest\/.+\/pcs\/adx|rest\/\d\.\d\/pcs\/adx|rest\/2\.0\/pcs\/ad),{{{百度网盘规则}}}
URL-REGEX,^https?:\/\/update\.pan\.baidu\.com\/statistics,{{{百度网盘规则}}}

# 微博：仅保留 v4.22 的安全广告域拦截，不启用深度响应改写
URL-REGEX,^https?:\/\/api\.weibo\.cn\/2\/(?:push\/active|client\/addlog_batch|ad\/preload),{{{微博规则}}}
URL-REGEX,^https?:\/\/api-cloudim\.api\.weibo\.com\/v1\/log\/,{{{微博规则}}}
DOMAIN-SUFFIX,biz.weibo.com,{{{微博规则}}}
DOMAIN-SUFFIX,promote.biz.weibo.cn,{{{微博规则}}}
DOMAIN,bootpreload.uve.weibo.com,{{{微博规则}}}
DOMAIN-SUFFIX,fastimage.uve.weibo.com,{{{微博规则}}}
DOMAIN-SUFFIX,adimg.vue.weibo.com,{{{微博规则}}}
DOMAIN-SUFFIX,adimg.uve.weibo.com,{{{微博规则}}}
DOMAIN-SUFFIX,ad.weibo.com,{{{微博规则}}}
DOMAIN-SUFFIX,wax.weibo.com,{{{微博规则}}}
DOMAIN,adpinpai.video.weibocdn.com,{{{微博规则}}}
DOMAIN-SUFFIX,ad.sina.com.cn,{{{微博规则}}}
DOMAIN-SUFFIX,ad4.sina.com.cn,{{{微博规则}}}
DOMAIN-SUFFIX,adbox.sina.com.cn,{{{微博规则}}}
DOMAIN-SUFFIX,adimg.mobile.sina.cn,{{{微博规则}}}
DOMAIN-SUFFIX,adimages.sina.com.hk,{{{微博规则}}}
DOMAIN-SUFFIX,img.adbox.sina.com.cn,{{{微博规则}}}
DOMAIN-SUFFIX,img.amp.ad.sina.com.cn,{{{微博规则}}}
DOMAIN,api.weibo.cn,DIRECT
DOMAIN,api.weibo.com,DIRECT
DOMAIN,mapi.weibo.cn,DIRECT
DOMAIN,mapi.weibo.com,DIRECT
DOMAIN,weibointl.api.weibo.cn,DIRECT
DOMAIN,weibointl.api.weibo.com,DIRECT
DOMAIN,m.weibo.cn,DIRECT

# 酷安：默认只做稳定直连；如需尝试去热搜/广告接口，可把“酷安规则”从 DIRECT 改为 REJECT
URL-REGEX,^https?:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch,{{{酷安规则}}}
DOMAIN,api.coolapk.com,DIRECT
DOMAIN,www.coolapk.com,DIRECT
DOMAIN,coolapk.com,DIRECT

# 微信公众号：广告域、广告接口、文章内嵌广告
DOMAIN-SUFFIX,ad.weixin.qq.com,{{{微信公众号规则}}}
DOMAIN,wxsnsdy.wxs.qq.com,{{{微信公众号规则}}}
DOMAIN,wxsnsdythumb.wxs.qq.com,{{{微信公众号规则}}}
DOMAIN-SUFFIX,wxsnsdythumb.wxs.qq.com,{{{微信公众号规则}}}
URL-REGEX,^https?:\/\/mp\.weixin\.qq\.com\/mp\/(?:getappmsgad|appmsgad|advertisement|ad|masonryfeed|relatedarticle|relatedsearchword|cps_product_info|jsmonitor)(?:\?|$),{{{微信公众号规则}}}

# 通用开屏 SDK：默认关闭，避免影响非目标 App；需要更强拦截再改 REJECT
DOMAIN-SUFFIX,adservice.sigmob.cn,{{{通用开屏SDK规则}}}
DOMAIN-SUFFIX,gdt.qq.com,{{{通用开屏SDK规则}}}
DOMAIN-SUFFIX,e.qq.com,{{{通用开屏SDK规则}}}
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,{{{通用开屏SDK规则}}}
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,{{{通用开屏SDK规则}}}
DOMAIN-SUFFIX,pglstatp-toutiao.com,{{{通用开屏SDK规则}}}

[Script]
闪动校园开屏净化 = type=http-response, pattern=^https?:\/\/(?:ad|report)\.shunchangzhixing\.com\/(?:report|channel\/report|display|click|track|event|win|upload|material|splash|ad|getAd|base\/\d+), script-path=https://raw.githubusercontent.com/wxs0625/quguanggaomokuai/main/v5.0/%E6%8C%89%E9%9C%80%E5%8E%BB%E5%B9%BF%E5%91%8A.js, requires-body=false, timeout=15, argument=app=shanxiao, enable={{{闪动校园脚本}}}
百度网盘开屏净化 = type=http-response, pattern=^https?:\/\/(?:issuecdn\.baidupcs\.com\/issue\/netdisk\/(?:guanggao|ts_ad)|pan\.baidu\.com\/(?:act\/|api\/|component\/|pmall\/|rest\/)|update\.pan\.baidu\.com\/statistics), script-path=https://raw.githubusercontent.com/wxs0625/quguanggaomokuai/main/v5.0/%E6%8C%89%E9%9C%80%E5%8E%BB%E5%B9%BF%E5%91%8A.js, requires-body=false, timeout=15, argument=app=baidupan, enable={{{百度网盘脚本}}}
微信公众号文章净化 = type=http-response, pattern=^https?:\/\/mp\.weixin\.qq\.com\/(?:s(?:\?|\/|$)|mp\/(?:appmsg\/show|getappmsgad|appmsgad|profile_ext|cps_product_info|masonryfeed|relatedarticle|relatedsearchword|jsmonitor)), script-path=https://raw.githubusercontent.com/wxs0625/quguanggaomokuai/main/v5.0/%E6%8C%89%E9%9C%80%E5%8E%BB%E5%B9%BF%E5%91%8A.js, requires-body=true, timeout=15, argument=app=wechat, enable={{{微信公众号脚本}}}

[MITM]
hostname = %APPEND% mp.weixin.qq.com, ad.weixin.qq.com, wxsnsdy.wxs.qq.com, wxsnsdythumb.wxs.qq.com, ad.shunchangzhixing.com, report.shunchangzhixing.com, issuecdn.baidupcs.com, pan.baidu.com, update.pan.baidu.com
