# “我的”页面去除冗余的模块
# 播放详情页,首页信息流,顶部tab,我的页面,评论区
# 底部tab
# 青少年模式弹窗
# 搜索列表
# 热剧弹窗
# 开屏广告

[Rule]

# v4.51 京东业务直连例外：避免旧版京东模块误拦启动所需服务
DOMAIN,dns.jd.com,DIRECT
DOMAIN,policy.jd.com,DIRECT
DOMAIN,im-x.jd.com,DIRECT
IP-CIDR,101.124.19.122/32,DIRECT,no-resolve
IP-CIDR6,2402:db40:5100:1011::5/128,DIRECT,no-resolve

# v4.54 全局请求级兜底：不依赖 MITM，覆盖明确开屏路径、广告接口和广告查询参数
URL-REGEX,"^https?:\/\/(?:[^\/]*\.)?(?:ad|ads|adserver|adservice|advert|advertise|advertising|advertisement|adproxy|mobads|adview|adsdk|pangle|pangolin|gromore|doubleclick|googleadservices)(?:[.-][^\/]*)?\/",REJECT
URL-REGEX,"^https?:\/\/[^\/]+\/(?:[^?]*\/)?(?:ad|ads|adimg|adimage|adimages|adresource|adresources|admaterial|admaterials|advert|advertise|advertising|advertisement|advertisements|adservice|adserver|adconfig|adinfo|adlist|adrequest|adslot|adunit|splash|splash_config|splash_info|splash_screen|splash_ads?|splashAd|splashConfig|splashInfo|splashScreen|splashScreenInfo|startup|startup_ad|startupAd|openscreen|open_screen|openScreen|open_screen_ad|openScreenAd|startpicture|startpage_ad|start_ad|startAd|boot_ad|bootAd|cold_start|coldstart|launch_screen|launchScreen|first_screen|firstScreen|openingBanner|open_advertisement|app_open_screen_ad|appOpenScreen|launch_ad|launchAd|getAppStartAd|getAppSplash|getSplashAd|getStartAd|getStartupAd|getOpenscreenBanners|get_splash_screen_info|start_screen_ads|queryStartAdvertisement)(?:[\/?&._-]|$)[^?]*(?:\?.*)?$",REJECT-DICT
URL-REGEX,"^https?:\/\/[^\/]+\/[^?]*\?(?:[^#]*&)?(?:ad|ads|advert|advertisement|advertising|adconfig|ad_config|adinfo|ad_info|adlist|ad_list|adrequest|ad_request|adslot|ad_slot|adunit|ad_unit|adspace|ad_space|splash|startup|openscreen|launch_ad|launchAd)(?:=|%3D|&|$)[^#]*$",REJECT-DICT

# v4.57 全局 QUIC 阻断：彻底防止 QUIC 协议绕过 MITM 导致开屏广告复发
# Shadowrocket 无法 MITM 解密 QUIC 流量，任何 App 使用 QUIC 都会绕过去广告规则
# v4.56 逐域名阻断仍有遗漏（新域名/CDN域名未覆盖），导致第一次冷启动广告漏过
# v4.57 改为全局阻断所有 QUIC，App 立即回退 TCP(TLS)，MITM 规则全面生效
# 使用 REJECT（立即拒绝+RST）而非 REJECT-DROP（静默丢包），避免 3-10 秒超时等待
PROTOCOL,QUIC,REJECT

# v4.57 闲鱼请求级开屏广告拦截：覆盖闲鱼开屏广告接口 idlecommerce.splash.ads 及其变体
# 注意：URL-REGEX 对 HTTPS 需 MITM 才能看到完整路径，此规则在 QUIC 阻断后 MITM 生效时起作用
URL-REGEX,"^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash(?:\.ads)?(?:\/|\?|$)",REJECT-DICT
URL-REGEX,"^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.home\.splash",REJECT-DICT
URL-REGEX,"^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idlecommerce\.splash(?:\.ads)?(?:\/|\?|$)",REJECT-DICT
# 闲鱼广告素材域名
DOMAIN,adashx.m.taobao.com,REJECT
DOMAIN,adash.man.aliyuncs.com,REJECT




